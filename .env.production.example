# Copy to .env.production and fill in all placeholders before first start.
# Never commit the real .env.production file.

# General
TZ=Europe/Berlin

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-this-strong-password
DB_NAME=smart-city-booking

# Public URLs (must be reachable by browser)
FRONTEND_URL=https://booking.university.example
BACKEND_URL=https://api.booking.university.example
VUE_APP_SERVER_BASE_URL=https://api.booking.university.example

# Backend security
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=booking.university.example
JWT_AUDIENCE=booking-users
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS512
CRYPTO_SECRET=replace-with-long-random-secret

# Mail and bootstrap
MAIL_ENABLED=true
INIT_ADMIN=admin@university.example
INIT_ADMIN_SECRET=replace-with-strong-bootstrap-secret

# Optional Nextcloud integration
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_URL=

# Frontend branding
VUE_APP_NAME=University Booking Platform
VUE_APP_CONTACT_ADDRESS=University Administration, Example Street 1
VUE_APP_CONTACT_URL=https://www.university.example/contact
VUE_APP_USERSNAP_API_KEY=

# Optional color overrides (leave empty to use defaults from frontend image)
VUE_APP_PRIMARY_COLOR=
VUE_APP_PRIMARY_COLOR_DARK=
VUE_APP_SECONDARY_COLOR=
VUE_APP_SECONDARY_COLOR_DARK=
VUE_APP_ACCENT_COLOR=
VUE_APP_ACCENT_COLOR_DARK=
VUE_APP_ERROR_COLOR=
VUE_APP_ERROR_COLOR_DARK=
VUE_APP_INFO_COLOR=
VUE_APP_INFO_COLOR_DARK=
VUE_APP_SUCCESS_COLOR=
VUE_APP_SUCCESS_COLOR_DARK=
VUE_APP_WARNING_COLOR=
VUE_APP_WARNING_COLOR_DARK=
VUE_APP_BODY_COLOR=
VUE_APP_BODY_COLOR_DARK=
VUE_APP_DARKGREY_COLOR=
VUE_APP_DARKGREY_COLOR_DARK=
